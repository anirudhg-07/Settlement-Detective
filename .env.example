# ---- Database ----------------------------------------------------------
POSTGRES_DB=settlement_detective
POSTGRES_USER=sd_owner
POSTGRES_PASSWORD=change_me_owner
POSTGRES_PORT=55432

# Owner connection - migrations, data generation, backend service layer
DATABASE_URL=postgresql+psycopg://sd_owner:change_me_owner@localhost:55432/settlement_detective

# Least-privilege role used by the AI investigation tool layer.
# Has NO grant on schema `gt` - ground truth is unreachable by construction.
AGENT_DATABASE_URL=postgresql+psycopg://sd_agent:change_me_agent@localhost:55432/settlement_detective
SD_AGENT_PASSWORD=change_me_agent

# Evaluation-only role. Can read ground truth. Never used by the agent.
EVAL_DATABASE_URL=postgresql+psycopg://sd_eval:change_me_eval@localhost:55432/settlement_detective
SD_EVAL_PASSWORD=change_me_eval

# ---- Reconciliation ----------------------------------------------------
TOLERANCE_PAISE=1
GST_RATE_BPS=1800
REVERSE_FEE_ON_REFUND=false
SETTLEMENT_CYCLE_DAYS=2
SETTLEMENT_GRACE_DAYS=1
AS_OF_DATE=2026-01-31

# Fee schedule in basis points (100 bps = 1.00%)
# SYNTHETIC MODEL DEFAULTS - not verified Razorpay pricing. See docs/ASSUMPTIONS.md
FEE_RATE_BPS_CARD=200
FEE_RATE_BPS_NETBANKING=190
FEE_RATE_BPS_UPI=0
FEE_RATE_BPS_WALLET=200

# ---- Evidence thresholds ----------------------------------------------
EVIDENCE_AUTO_RESOLVE=90
EVIDENCE_REVIEW_MIN=60

# ---- LLM (Phase 7) -----------------------------------------------------
# Provider is pluggable; swapping it is a one-line change.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOOL_CALLS=8
LLM_RPM=10

# ---- External (Phase 7 / Phase 11) ------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
LLM_API_KEY=
